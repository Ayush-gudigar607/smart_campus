  "item": [
    {
      "name": "01 - Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('reports a healthy API', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data.status).to.eql('ok');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 - Register student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentName\": \"Postman Student\",\n  \"usn\": \"{{studentUsn}}\",\n  \"departmentId\": {{departmentId}},\n  \"currentYear\": 2,\n  \"email\": \"{{studentEmail}}\",\n  \"mobileNumber\": \"+919876543210\",\n  \"password\": \"{{studentPassword}}\",\n  \"confirmPassword\": \"{{studentPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const id = Date.now();",
              "pm.collectionVariables.set('studentEmail', `postman.${id}@example.com`);",
              "pm.collectionVariables.set('studentUsn', `PM${id}`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('registers with HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('returns a token and public user', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data.token).to.be.a('string').and.not.empty;",
              "    pm.expect(body.data.user.email).to.eql(pm.collectionVariables.get('studentEmail'));",
              "    pm.expect(body.data.user).to.not.have.property('passwordHash');",
              "    pm.collectionVariables.set('token', body.data.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 - Get current user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('returns the registered student', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data.email).to.eql(pm.collectionVariables.get('studentEmail'));",
              "    pm.expect(body.data).to.not.have.property('passwordHash');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
