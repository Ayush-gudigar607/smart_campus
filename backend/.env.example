PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_service
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional seed overrides (change the default password if you use it)
SEED_ADMIN_EMAIL=admin@campus.local
SEED_ADMIN_PASSWORD=Admin12345
